	vreg_wcn_1p9: regulator-wcn-1p9 {
		regulator-max-microvolt = <0x1cfde0>;
		regulator-min-microvolt = <0x1cfde0>;
		regulator-name = "VREG_WCN_1P9";
		compatible = "regulator-fixed";
		phandle = <0x1cd>;
		vin-supply = <0x1bd>;
	};

	vreg_pcie3_nvme: regulator-pcie3-nvme {
		regulator-max-microvolt = <0x325aa0>;
		pinctrl-names = "default";
		regulator-boot-on;
		gpio = <0x117 0x05 0x00>;
		pinctrl-0 = <0x1bc>;
		regulator-always-on;
		enable-active-high;
		regulator-min-microvolt = <0x325aa0>;
		regulator-name = "VREG_PCIE3_NVME_3P3";
		startup-delay-us = <0x1e8480>;
		compatible = "regulator-fixed";
		phandle = <0xaa>;
	};

	smp2p-cdsp {
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x05>;
		interrupts-extended = <0x26 0x06 0x02 0x01>;
		compatible = "qcom,smp2p";
		mboxes = <0x26 0x06 0x02>;
		qcom,smem = <0x5e 0x1b0>;

		smp2p_cdsp_in: slave-kernel {
			qcom,entry-name = "slave-kernel";
			#interrupt-cells = <0x02>;
			phandle = <0x197>;
			interrupt-controller;
		};

		smp2p_cdsp_out: master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x19b>;
		};
	};

	wcd938x: audio-codec {
		qcom,micbias4-microvolt = <0x1b7740>;
		pinctrl-names = "default";
		qcom,mbhc-buttons-vthreshold-microvolt = <0x124f8 0x249f0 0x39dc8 0x7a120 0x7a120 0x7a120 0x7a120 0x7a120>;
		pinctrl-0 = <0x1ac>;
		qcom,micbias2-microvolt = <0x1b7740>;
		vdd-buck-supply = <0xd5>;
		#sound-dai-cells = <0x01>;
		reset-gpios = <0x5b 0xbf 0x01>;
		compatible = "qcom,wcd9385-codec";
		qcom,micbias3-microvolt = <0x1b7740>;
		qcom,rx-device = <0x1ad>;
		vdd-io-supply = <0xd5>;
		vdd-rxtx-supply = <0xd5>;
		phandle = <0x1c4>;
		qcom,tx-device = <0x1ae>;
		qcom,mbhc-headphone-vthreshold-microvolt = <0xc350>;
		qcom,micbias1-microvolt = <0x1b7740>;
		vdd-mic-bias-supply = <0x191>;
		qcom,mbhc-headset-vthreshold-microvolt = <0x19f0a0>;
	};

	vreg_nvme: regulator-nvme {
		regulator-max-microvolt = <0x325aa0>;
		pinctrl-names = "default";
		regulator-boot-on;
		gpio = <0x5b 0x12 0x00>;
		pinctrl-0 = <0x1bb>;
		regulator-always-on;
		enable-active-high;
		regulator-min-microvolt = <0x325aa0>;
