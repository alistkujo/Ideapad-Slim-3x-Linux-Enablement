		tpda@10c2b000 {
			clock-names = "apb_pclk";
			clocks = <0xc2>;
			compatible = "qcom,coresight-tpda", "arm,primecell";
			reg = <0x00 0x10c2b000 0x00 0x1000>;

			in-ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@14 {
					reg = <0x14>;

					dlct1_tpda_in20: endpoint {
						remote-endpoint = <0x161>;
						phandle = <0x13a>;
					};
				};

				port@1b {
					reg = <0x1b>;

					dlct1_tpda_in27: endpoint {
						remote-endpoint = <0x164>;
						phandle = <0x15e>;
					};
				};

				port@15 {
					reg = <0x15>;

