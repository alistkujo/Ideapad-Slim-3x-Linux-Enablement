/dts-v1/;

/ {
	lenovo-83n3-usb2-test = "active";
	#address-cells = <0x02>;
	model = "Lenovo IdeaPad Slim 3 15Q8X10";
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	compatible = "lenovo,ideapad-slim3", "lenovo,thinkpad-t14s", "qcom,x126100", "qcom,x1p42100";
	chassis-type = "laptop";

	vreg_edp_3p3: regulator-edp-3p3 {
		regulator-max-microvolt = <0x325aa0>;
		pinctrl-names = "default";
		regulator-boot-on;
		gpio = <0x5b 0x46 0x00>;
		pinctrl-0 = <0x1b9>;
		enable-active-high;
		regulator-min-microvolt = <0x325aa0>;
		regulator-name = "VREG_EDP_3P3";
		compatible = "regulator-fixed";
		phandle = <0x119>;
	};

	pmic-glink {
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		orientation-gpios = <0x5b 0x79 0x00 0x5b 0x7b 0x00 0x5b 0x7d 0x00>;
		compatible = "qcom,x1e80100-pmic-glink", "qcom,pmic-glink";

		connector@0 {
			power-role = "dual";
			data-role = "host";
			compatible = "usb-c-connector";
			reg = <0x00>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					pmic_glink_ss0_hs_in: endpoint {
						remote-endpoint = <0x1b6>;
						phandle = <0xee>;
					};
				};

				port@1 {
					reg = <0x01>;

					pmic_glink_ss0_ss_in: endpoint {
						remote-endpoint = <0x1b7>;
						phandle = <0x9d>;
					};
				};

				port@2 {
					reg = <0x02>;

					pmic_glink_ss0_sbu: endpoint {
						remote-endpoint = <0x1b8>;
						phandle = <0x1cb>;
					};
				};
			};
		};
	};

	clk_virt: interconnect-0 {
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x1d>;
		compatible = "qcom,x1e80100-clk-virt";
		phandle = <0x34>;
	};

	soc: soc@0 {
		dma-ranges = <0x00 0x00 0x00 0x00 0x100 0x00>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "simple-bus";
		ranges = <0x00 0x00 0x00 0x00 0x100 0x00>;
		phandle = <0x1f8>;

		usb_mp_qmpphy1: phy@88e5000 {
			power-domains = <0x33 0x14>;
			clock-output-names = "usb_mp_phy1_pipe_clk";
			clock-names = "aux", "ref", "com_aux", "pipe";
			resets = <0x33 0x48 0x33 0x4d>;
			clocks = <0x33 0x117 0x02 0x00 0x33 0x119 0x33 0x11b>;
			#clock-cells = <0x00>;
			vdda-phy-supply = <0xb5>;
			#phy-cells = <0x00>;
			vdda-pll-supply = <0xe3>;
			compatible = "qcom,x1e80100-qmp-usb3-uni-phy";
			status = "okay";
			reg = <0x00 0x88e5000 0x00 0x2000>;
			phandle = <0xec>;
			reset-names = "phy", "phy_phy";
		};

		nsp_noc: interconnect@320c0000 {
			#interconnect-cells = <0x02>;
			qcom,bcm-voters = <0x1d>;
			compatible = "qcom,x1e80100-nsp-noc";
			reg = <0x00 0x320c0000 0x00 0xe080>;
			phandle = <0x198>;
		};

		tpdm@1000f000 {
			clock-names = "apb_pclk";
			qcom,cmb-msrs-num = <0x20>;
			clocks = <0xc2>;
			compatible = "qcom,coresight-tpdm", "arm,primecell";
			reg = <0x00 0x1000f000 0x00 0x1000>;
			qcom,cmb-element-bits = <0x20>;

			out-ports {

				port {

					qdss_tpdm_out: endpoint {
						remote-endpoint = <0x129>;
						phandle = <0x127>;
					};
				};
			};
		};

		usb_mp_hsphy1: phy@88e2000 {
			clock-names = "ref";
			resets = <0x33 0x35>;
			clocks = <0x19 0x04>;
			#phy-cells = <0x00>;
			vdd-supply = <0xdf>;
			compatible = "qcom,x1e80100-snps-eusb2-phy", "qcom,sm8550-snps-eusb2-phy";
			vdda12-supply = <0xb5>;
			status = "okay";
			phys = <0xe2>;
			reg = <0x00 0x88e2000 0x00 0x154>;
			phandle = <0xeb>;
		};

		tpdm@10c08000 {
			clock-names = "apb_pclk";
			clocks = <0xc2>;
			qcom,dsb-element-bits = <0x20>;
			compatible = "qcom,coresight-tpdm", "arm,primecell";
			reg = <0x00 0x10c08000 0x00 0x1000>;
			qcom,dsb-msrs-num = <0x20>;

			out-ports {

				port {

					mm_tpdm_out: endpoint {
						remote-endpoint = <0x15a>;
						phandle = <0x15b>;
					};
				};
			};
		};

		lpass_wsamacro: codec@6b00000 {
			clock-output-names = "wsa-mclk";
			clock-names = "mclk", "macro", "dcodec", "fsgen";
			assigned-clocks = <0xca 0x42 0x01>;
			assigned-clock-rates = <0x124f800>;
			clocks = <0xca 0x42 0x01 0xca 0x66 0x01 0xca 0x67 0x01 0xcb>;
			#clock-cells = <0x00>;
			#sound-dai-cells = <0x01>;
			sound-name-prefix = "WSA";
			compatible = "qcom,x1e80100-lpass-wsa-macro", "qcom,sm8550-lpass-wsa-macro";
			status = "okay";
			reg = <0x00 0x6b00000 0x00 0x1000>;
			phandle = <0xd1>;
		};

		sram@c3f0000 {
			compatible = "qcom,rpmh-stats";
			reg = <0x00 0xc3f0000 0x00 0x400>;
		};

		cti@1098b000 {
			clock-names = "apb_pclk";
			clocks = <0xc2>;
			compatible = "arm,coresight-cti", "arm,primecell";
			reg = <0x00 0x1098b000 0x00 0x1000>;
		};

		funnel@10cc5000 {
			clock-names = "apb_pclk";
			clocks = <0xc2>;
			compatible = "arm,coresight-dynamic-funnel", "arm,primecell";
			reg = <0x00 0x10cc5000 0x00 0x1000>;

			in-ports {

				port {

					tmess_funnel_in0: endpoint {
						remote-endpoint = <0x176>;
						phandle = <0x175>;
					};
				};
			};

			out-ports {

				port {

					tmess_funnel_out: endpoint {
						remote-endpoint = <0x177>;
						phandle = <0x12d>;
					};
				};
			};
		};

		lpass_lpiaon_noc: interconnect@7400000 {
			#interconnect-cells = <0x02>;
			qcom,bcm-voters = <0x1d>;
			compatible = "qcom,x1e80100-lpass-lpiaon-noc";
			reg = <0x00 0x7400000 0x00 0x19080>;
			phandle = <0x245>;
		};

		csiphy1: csiphy@ace6000 {
			power-domains = <0xf8 0x05>;
			clock-names = "camnoc_axi", "cpas_ahb", "csiphy", "csiphy_timer";
			interrupts = <0x00 0x1de 0x01>;
			clocks = <0xf8 0x05 0xf8 0x0e 0xf8 0x27 0xf8 0x19>;
			#phy-cells = <0x00>;
			compatible = "qcom,x1e80100-mipi-csi2-combo-phy";
			status = "disabled";
			reg = <0x00 0xace6000 0x00 0x2000>;
			phandle = <0xfe>;
		};

		config_noc: interconnect@1600000 {
			#interconnect-cells = <0x02>;
			qcom,bcm-voters = <0x1d>;
			compatible = "qcom,x1e80100-cnoc-cfg";
			reg = <0x00 0x1600000 0x00 0x6600>;
			phandle = <0x36>;
		};

		tpdm@10b0b000 {
			clock-names = "apb_pclk";
			qcom,cmb-msrs-num = <0x20>;
			clocks = <0xc2>;
			compatible = "qcom,coresight-tpdm", "arm,primecell";
			reg = <0x00 0x10b0b000 0x00 0x1000>;
			qcom,cmb-element-bits = <0x40>;

			out-ports {

				port {

					aoss_tpdm2_out: endpoint {
						remote-endpoint = <0x152>;
						phandle = <0x14c>;
					};
				};
			};
		};

		tpdm@10d0d000 {
			clock-names = "apb_pclk";
			qcom,cmb-msrs-num = <0x20>;
			clocks = <0xc2>;
			compatible = "qcom,coresight-tpdm", "arm,primecell";
			reg = <0x00 0x10d0d000 0x00 0x1000>;
			qcom,cmb-element-bits = <0x20>;

			out-ports {

				port {

					llcc5_tpdm_out: endpoint {
						remote-endpoint = <0x17f>;
						phandle = <0x187>;
					};
				};
			};
		};

		sbsa_watchdog: watchdog@1c840000 {
			interrupts = <0x00 0x00 0x04>;
			compatible = "arm,sbsa-gwdt";
			reg = <0x00 0x1c840000 0x00 0x1000 0x00 0x1c850000 0x00 0x1000>;
			phandle = <0x2a0>;
		};

		usb_1_ss1_qmpphy: phy@fda000 {
			power-domains = <0x33 0x19>;
			orientation-switch;
			clock-names = "aux", "ref", "com_aux", "usb3_pipe";
			resets = <0x33 0x45 0x33 0x50>;
			clocks = <0x33 0x120 0x19 0x07 0x33 0x122 0x33 0x123>;
			#clock-cells = <0x01>;
			#phy-cells = <0x01>;
			compatible = "qcom,x1e80100-qmp-usb3-dp-phy";
			mode-switch;
			status = "disabled";
			reg = <0x00 0xfda000 0x00 0x4000>;
			phandle = <0x2e>;
			reset-names = "phy", "common";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					usb_1_ss1_qmpphy_out: endpoint {
						phandle = <0x230>;
					};
				};

				port@1 {
					reg = <0x01>;

					usb_1_ss1_qmpphy_usb_ss_in: endpoint {
						remote-endpoint = <0xa1>;
						phandle = <0xf1>;
					};
				};

				port@2 {
					reg = <0x02>;

					usb_1_ss1_qmpphy_dp_in: endpoint {
						remote-endpoint = <0xa2>;
						phandle = <0x10e>;
					};
				};
			};
		};

		lpass_tlmm: pinctrl@6e80000 {
			clock-names = "core", "audio";
			gpio-controller;
			clocks = <0xca 0x66 0x01 0xca 0x67 0x01>;
			compatible = "qcom,x1e80100-lpass-lpi-pinctrl", "qcom,sm8550-lpass-lpi-pinctrl";
			reg = <0x00 0x6e80000 0x00 0x20000 0x00 0x7250000 0x00 0x10000>;
			phandle = <0xd4>;
			#gpio-cells = <0x02>;
			gpio-ranges = <0xd4 0x00 0x00 0x17>;

			wsa_swr_active: wsa-swr-active-state {
				phandle = <0xd2>;

				clk-pins {
					function = "wsa_swr_clk";
					pins = "gpio10";
					drive-strength = <0x02>;
					bias-disable;
					slew-rate = <0x01>;
				};

				data-pins {
					function = "wsa_swr_data";
					pins = "gpio11";
					drive-strength = <0x02>;
					bias-bus-hold;
					slew-rate = <0x01>;
				};
			};

			dmic01_default: dmic01-default-state {
				phandle = <0xd9>;

				clk-pins {
					function = "dmic1_clk";
					pins = "gpio6";
					drive-strength = <0x08>;
					output-high;
				};

				data-pins {
					function = "dmic1_data";
					pins = "gpio7";
					drive-strength = <0x08>;
					input-enable;
				};
			};

			wsa2_swr_active: wsa2-swr-active-state {
				phandle = <0xcd>;

				clk-pins {
					function = "wsa2_swr_clk";
					pins = "gpio15";
					drive-strength = <0x02>;
					bias-disable;
					slew-rate = <0x01>;
				};

				data-pins {
					function = "wsa2_swr_data";
					pins = "gpio16";
					drive-strength = <0x02>;
					bias-bus-hold;
					slew-rate = <0x01>;
				};
			};

			dmic23_default: dmic23-default-state {
				phandle = <0x243>;

				clk-pins {
					function = "dmic2_clk";
					pins = "gpio8";
					drive-strength = <0x08>;
					output-high;
				};

				data-pins {
					function = "dmic2_data";
					pins = "gpio9";
					drive-strength = <0x08>;
					input-enable;
				};
			};

			tx_swr_active: tx-swr-active-state {
				phandle = <0xd8>;

				clk-pins {
					function = "swr_tx_clk";
					pins = "gpio0";
					drive-strength = <0x02>;
					bias-disable;
					slew-rate = <0x01>;
				};

				data-pins {
					function = "swr_tx_data";
					pins = "gpio1", "gpio2";
					drive-strength = <0x02>;
					bias-bus-hold;
					slew-rate = <0x01>;
				};
			};

			spkr_01_sd_n_active: spkr-01-sd-n-active-state {
				function = "gpio";
				pins = "gpio12";
				drive-strength = <0x10>;
				bias-disable;
				phandle = <0xd3>;
				output-low;
			};

			rx_swr_active: rx-swr-active-state {
				phandle = <0xd0>;

				clk-pins {
					function = "swr_rx_clk";
					pins = "gpio3";
					drive-strength = <0x02>;
					bias-disable;
					slew-rate = <0x01>;
				};

				data-pins {
					function = "swr_rx_data";
					pins = "gpio4", "gpio5";
					drive-strength = <0x02>;
					bias-bus-hold;
					slew-rate = <0x01>;
				};
			};
		};

		pcie3_phy: phy@1bd4000 {
			power-domains = <0x33 0x04>;
			clock-output-names = "pcie3_pipe_clk";
			clock-names = "aux", "cfg_ahb", "ref", "rchng", "pipe", "pipediv2";
			assigned-clocks = <0x33 0x59>;
			assigned-clock-rates = <0x5f5e100>;
			resets = <0x33 0x16 0x33 0x15>;
			clocks = <0x33 0x58 0x33 0x56 0x19 0x02 0x33 0x59 0x33 0x5b 0x33 0x5d>;
			#clock-cells = <0x00>;
			vdda-phy-supply = <0xe3>;
			#phy-cells = <0x00>;
			vdda-pll-supply = <0xb5>;
			compatible = "qcom,x1p42100-qmp-gen4x4-pcie-phy";
			status = "okay";
			reg = <0x00 0x1bd4000 0x00 0x2000 0x00 0x1bd6000 0x00 0x2000>;
			phandle = <0x29>;
			reset-names = "phy", "phy_nocsr";
			vdda-qref-supply = <0x99>;
		};

		pmu@24091000 {
			interconnects = <0x18 0x00 0x03 0x18 0x01 0x03>;
			interrupts = <0x00 0x51 0x04>;
			compatible = "qcom,x1e80100-llcc-bwmon", "qcom,sc7280-llcc-bwmon";
			reg = <0x00 0x24091000 0x00 0x1000>;
			operating-points-v2 = <0x195>;

			llcc_bwmon_opp_table: opp-table {
				compatible = "operating-points-v2";
				phandle = <0x195>;

				opp-7 {
					opp-peak-kBps = <0xc28800>;
				};

				opp-5 {
					opp-peak-kBps = <0x7fbc00>;
				};

				opp-3 {
					opp-peak-kBps = <0x5eec00>;
				};

				opp-1 {
					opp-peak-kBps = <0x2162e0>;
				};

				opp-8 {
					opp-peak-kBps = <0xe10000>;
				};

				opp-6 {
					opp-peak-kBps = <0xa6fe00>;
				};

				opp-4 {
					opp-peak-kBps = "", "hL";
				};

				opp-2 {
					opp-peak-kBps = <0x2ee000>;
				};

				opp-0 {
					opp-peak-kBps = "", "\f5";
				};

				opp-9 {
					opp-peak-kBps = <0x101d000>;
				};
			};
		};

		tpdm@10d0a000 {
			clock-names = "apb_pclk";
			qcom,cmb-msrs-num = <0x20>;
			clocks = <0xc2>;
			compatible = "qcom,coresight-tpdm", "arm,primecell";
			reg = <0x00 0x10d0a000 0x00 0x1000>;
			qcom,cmb-element-bits = <0x20>;

			out-ports {

				port {

					llcc2_tpdm_out: endpoint {
						remote-endpoint = <0x17c>;
						phandle = <0x184>;
					};
				};
			};
		};

		swr0: soundwire@6b10000 {
			qcom,ports-offset2 = [ff 07 1f ff 07 1f ff ff ff ff ff ff ff];
			pinctrl-names = "default";
			#address-cells = <0x02>;
			qcom,ports-block-pack-mode = [00 01 01 00 01 01 00 00 00 01 01 00 00];
			qcom,ports-block-group-count = [ff ff ff ff ff ff ff ff ff ff ff ff ff];
			qcom,ports-hstart = [ff ff ff ff ff ff 08 ff ff ff ff ff 0f];
			pinctrl-0 = <0xd2 0xd3>;
			clock-names = "iface";
			qcom,ports-sinterval = [00 07 00 1f 00 3f 00 07 00 1f 00 3f 00 c8 00 ff 00 ff 00 0f 00 0f 00 ff 03 1f];
			resets = <0xce 0x01>;
			interrupts = <0x00 0xaa 0x04>;
			clocks = <0xd1>;
			#size-cells = <0x00>;
			label = "WSA";
			qcom,ports-offset1 = [01 03 05 02 04 15 00 ff ff 06 0d ff 00];
			#sound-dai-cells = <0x01>;
			compatible = "qcom,soundwire-v2.0.0";
			status = "okay";
			reg = <0x00 0x6b10000 0x00 0x10000>;
			qcom,dout-ports = <0x09>;
			phandle = <0x1c9>;
			qcom,ports-word-length = [ff ff ff ff ff ff 08 ff ff ff ff ff 18];
			reset-names = "swr_audio_cgcr";
			qcom,ports-hstop = [ff ff ff ff ff ff 08 ff ff ff ff ff 0f];
			qcom,din-ports = <0x04>;
			qcom,ports-lane-control = [ff ff ff ff ff ff ff ff ff ff ff ff ff];

			left_spkr: speaker@0,0 {
				qcom,port-mapping = <0x01 0x02 0x03 0x07 0x0a 0x0d>;
				#sound-dai-cells = <0x00>;
				reset-gpios = <0xd4 0x0c 0x01>;
				sound-name-prefix = "SpkrLeft";
				compatible = "sdw20217020400";
				vdd-io-supply = <0x45>;
				reg = <0x00 0x00>;
				phandle = <0x1c7>;
				vdd-1p8-supply = <0xd5>;
			};

			right_spkr: speaker@0,1 {
				qcom,port-mapping = <0x04 0x05 0x06 0x07 0x0b 0x0d>;
				#sound-dai-cells = <0x00>;
				reset-gpios = <0xd4 0x0c 0x01>;
				sound-name-prefix = "SpkrRight";
				compatible = "sdw20217020400";
				vdd-io-supply = <0x45>;
				reg = <0x00 0x01>;
				phandle = <0x1c8>;
				vdd-1p8-supply = <0xd5>;
			};
		};

		pcie5: pci@1c00000 {
			power-domains = <0x33 0x07>;
			eq-presets-8gts = <0x55555555>;
			pinctrl-names = "default";
			#address-cells = <0x03>;
			dma-coherent;
			interconnect-names = "pcie-mem", "cpu-pcie";
			bus-range = <0x00 0xff>;
			pinctrl-0 = <0xb3>;
			clock-names = "aux", "cfg", "bus_master", "bus_slave", "slave_q2a", "noc_aggr", "cnoc_sf_axi";
			interconnects = <0xa7 0x02 0x07 0x18 0x01 0x07 0x35 0x03 0x03 0xa8 0x0d 0x03>;
			reg-names = "parf", "dbi", "elbi", "atu", "config", "mhi";
			assigned-clocks = <0x33 0x6b>;
			assigned-clock-rates = <0x124f800>;
			resets = <0x33 0x1d 0x33 0x1e>;
			interrupts = <0x00 0x5e 0x04 0x00 0x5f 0x04 0x00 0x60 0x04 0x00 0x59 0x04 0x00 0x56 0x04 0x00 0x52 0x04 0x00 0x4d 0x04 0x00 0x4e 0x04 0x00 0x9d 0x04>;
			clocks = <0x33 0x6b 0x33 0x6d 0x33 0x6e 0x33 0x74 0x33 0x75 0x33 0x15 0x33 0x21>;
			interrupt-map = <0x00 0x00 0x00 0x01 0x01 0x00 0x00 0x00 0x46 0x04 0x00 0x00 0x00 0x02 0x01 0x00 0x00 0x00 0x47 0x04 0x00 0x00 0x00 0x03 0x01 0x00 0x00 0x00 0x48 0x04 0x00 0x00 0x00 0x04 0x01 0x00 0x00 0x00 0x49 0x04>;
			vddpe-3v3-supply = <0xb2>;
			#size-cells = <0x02>;
			device_type = "pci";
			interrupt-map-mask = <0x00 0x00 0x00 0x07>;
			num-lanes = <0x02>;
			compatible = "qcom,pcie-x1e80100";
