						remote-endpoint = <0x162>;
						phandle = <0x135>;
					};
				};

				port@13 {
					reg = <0x13>;

					dlct1_tpda_in19: endpoint {
						remote-endpoint = <0x160>;
						phandle = <0x136>;
					};
				};

				port@1a {
					reg = <0x1a>;

					dlct1_tpda_in26: endpoint {
						remote-endpoint = <0x163>;
						phandle = <0x15d>;
					};
				};

				port@4 {
					reg = <0x04>;

					dlct1_tpda_in4: endpoint {
						remote-endpoint = <0x15f>;
						phandle = <0x139>;
					};
				};
			};

			out-ports {

