						edp_bl_en: edp-bl-en-state {
							input-disable;
							function = "normal";
							pins = "gpio4";
							phandle = <0x118>;
							output-enable;
							power-source = <0x01>;
						};

						pcie3_nvme_reg_en: pcie3-nvme-reg-en-state {
							input-disable;
							function = "normal";
							drive-push-pull;
							pins = "gpio5";
							qcom,drive-strength = <0x03>;
							bias-disable;
							phandle = <0x1bc>;
							output-enable;
							power-source = <0x00>;
						};
					};

					pmc8380_3_temp_alarm: temp-alarm@a00 {
						interrupts = <0x03 0x0a 0x00 0x03>;
						#thermal-sensor-cells = <0x00>;
						compatible = "qcom,spmi-temp-alarm";
						reg = <0xa00>;
						phandle = <0x1a6>;
					};
				};

				pm8550: pmic@1 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					compatible = "qcom,pm8550", "qcom,spmi-pmic";
					reg = <0x01 0x00>;
