	qup_opp_table_120mhz: opp-table-qup120mhz {
		compatible = "operating-points-v2";
		phandle = <0x39>;

		opp-120000000 {
			opp-hz = <0x00 0x7270e00>;
			required-opps = <0x25>;
		};

		opp-75000000 {
			opp-hz = <0x00 0x47868c0>;
			required-opps = <0x24>;
		};
	};

	clocks {

		xo_board: xo-board {
			#clock-cells = <0x00>;
			clock-frequency = <0x493e000>;
			compatible = "fixed-clock";
			phandle = <0x18d>;
		};

		bi_tcxo_ao_div2: bi-tcxo-ao-div2-clk {
			clock-div = <0x02>;
			clock-mult = <0x01>;
			clocks = <0x02 0x01>;
			#clock-cells = <0x00>;
			compatible = "fixed-factor-clock";
			phandle = <0x101>;
		};

		bi_tcxo_div2: bi-tcxo-div2-clk {
			clock-div = <0x02>;
			clock-mult = <0x01>;
			clocks = <0x02 0x00>;
			#clock-cells = <0x00>;
			compatible = "fixed-factor-clock";
			phandle = <0x27>;
		};

		sleep_clk: sleep-clk {
			#clock-cells = <0x00>;
			clock-frequency = <0x7ffc>;
			compatible = "fixed-clock";
			phandle = <0x28>;
		};
	};

	usb-1-ss0-sbu-mux {
		pinctrl-names = "default";
		orientation-switch;
		select-gpios = <0x5b 0xa7 0x00>;
		pinctrl-0 = <0x1ca>;
		compatible = "onnn,fsusb42", "gpio-sbu-mux";
		mode-switch;
		enable-gpios = <0x5b 0xa8 0x01>;

		port {

			usb_1_ss0_sbu_mux: endpoint {
				remote-endpoint = <0x1cb>;
				phandle = <0x1b8>;
			};
		};
	};

	vreg_wcn_0p95: regulator-wcn-0p95 {
		regulator-max-microvolt = <0xe7ef0>;
		regulator-min-microvolt = <0xe7ef0>;
		regulator-name = "VREG_WCN_0P95";
		compatible = "regulator-fixed";
		phandle = <0x1cc>;
		vin-supply = <0x1bd>;
	};

	psci {
		method = "smc";
		compatible = "arm,psci-1.0";

		cluster_pd1: power-domain-cpu-cluster1 {
			power-domains = <0x22>;
			domain-idle-states = <0x21>;
			#power-domain-cells = <0x00>;
			phandle = <0x20>;
		};

		cpu_pd6: power-domain-cpu6 {
			power-domains = <0x20>;
			domain-idle-states = <0x1f>;
			#power-domain-cells = <0x00>;
			phandle = <0x0c>;
		};

		cpu_pd4: power-domain-cpu4 {
			power-domains = <0x20>;
			domain-idle-states = <0x1f>;
			#power-domain-cells = <0x00>;
			phandle = <0x0a>;
		};

		cpu_pd2: power-domain-cpu2 {
			power-domains = <0x1e>;
			domain-idle-states = <0x1f>;
			#power-domain-cells = <0x00>;
			phandle = <0x07>;
		};

		cpu_pd0: power-domain-cpu0 {
			power-domains = <0x1e>;
			domain-idle-states = <0x1f>;
			#power-domain-cells = <0x00>;
			phandle = <0x04>;
		};

		cpu_pd7: power-domain-cpu7 {
			power-domains = <0x20>;
			domain-idle-states = <0x1f>;
			#power-domain-cells = <0x00>;
			phandle = <0x0d>;
		};

		system_pd: power-domain-system {
			#power-domain-cells = <0x00>;
			phandle = <0x22>;
		};

		cluster_pd0: power-domain-cpu-cluster0 {
			power-domains = <0x22>;
			domain-idle-states = <0x21>;
			#power-domain-cells = <0x00>;
			phandle = <0x1e>;
		};

		cpu_pd5: power-domain-cpu5 {
			power-domains = <0x20>;
			domain-idle-states = <0x1f>;
			#power-domain-cells = <0x00>;
			phandle = <0x0b>;
		};

		cpu_pd3: power-domain-cpu3 {
			power-domains = <0x1e>;
			domain-idle-states = <0x1f>;
			#power-domain-cells = <0x00>;
			phandle = <0x08>;
		};

		cpu_pd1: power-domain-cpu1 {
			power-domains = <0x1e>;
			domain-idle-states = <0x1f>;
			#power-domain-cells = <0x00>;
			phandle = <0x06>;
		};
	};

	vreg_misc_3p3: regulator-misc-3p3 {
		regulator-max-microvolt = <0x325aa0>;
		pinctrl-names = "default";
		regulator-boot-on;
		gpio = <0x120 0x06 0x00>;
		pinctrl-0 = <0x1ba>;
		regulator-always-on;
		enable-active-high;
		regulator-min-microvolt = <0x325aa0>;
		regulator-name = "VREG_MISC_3P3";
		compatible = "regulator-fixed";
		phandle = <0x44>;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x00>;
	};

	vph_pwr: regulator-vph-pwr {
		regulator-max-microvolt = <0x387520>;
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <0x387520>;
		regulator-name = "vph_pwr";
		compatible = "regulator-fixed";
		phandle = <0x18f>;
	};

	mc_virt: interconnect-1 {
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x1d>;
		compatible = "qcom,x1e80100-mc-virt";
		phandle = <0x18>;
	};

	gpio-keys {
		pinctrl-names = "default";
		pinctrl-0 = <0x1b1>;
		compatible = "gpio-keys";

		switch-lid {
			wakeup-source;
			linux,input-type = <0x05>;
			linux,code = <0x00>;
			wakeup-event-action = <0x02>;
			gpios = <0x5b 0x5c 0x01>;
		};
	};

	vreg_wcn_3p3: regulator-wcn-3p3 {
		regulator-max-microvolt = <0x325aa0>;
		pinctrl-names = "default";
		regulator-boot-on;
		gpio = <0x5b 0xd6 0x00>;
		pinctrl-0 = <0x1be>;
		enable-active-high;
		regulator-min-microvolt = <0x325aa0>;
		regulator-name = "VREG_WCN_3P3";
		compatible = "regulator-fixed";
		phandle = <0x1bd>;
	};

	timer {
		interrupts = <0x01 0x0d 0x08 0x01 0x0e 0x08 0x01 0x0b 0x08 0x01 0x0a 0x08>;
		compatible = "arm,armv8-timer";
	};

	smp2p-adsp {
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x02>;
		interrupts-extended = <0x26 0x03 0x02 0x01>;
		compatible = "qcom,smp2p";
		mboxes = <0x26 0x03 0x02>;
		qcom,smem = <0x1bb 0x1ad>;

		smp2p_adsp_in: slave-kernel {
			qcom,entry-name = "slave-kernel";
			#interrupt-cells = <0x02>;
			phandle = <0xc4>;
			interrupt-controller;
		};

		smp2p_adsp_out: master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0xc8>;
		};
	};

	aliases {
		serial1 = "/soc@0/geniqup@ac0000/serial@a98000";
		serial0 = "/soc@0/geniqup@8c0000/serial@894000";
	};

	sound {
		model = "X1E80100-LENOVO-Ideapad-3";
		audio-routing = "SpkrLeft IN", "WSA WSA_SPK1 OUT", "SpkrRight IN", "WSA WSA_SPK2 OUT", "IN1_HPHL", "HPHL_OUT", "IN2_HPHR", "HPHR_OUT", "AMIC2", "MIC BIAS2", "VA DMIC0", "MIC BIAS3", "VA DMIC1", "MIC BIAS3", "VA DMIC0", "VA MIC BIAS1", "VA DMIC1", "VA MIC BIAS1", "TX SWR_INPUT1", "ADC2_OUTPUT";
		compatible = "qcom,x1e80100-sndcard";

		wcd-playback-dai-link {
			link-name = "WCD Playback";

			platform {
				sound-dai = <0x1c2>;
			};

			cpu {
				sound-dai = <0x1c1 0x71>;
			};

			codec {
				sound-dai = <0x1c4 0x00 0x1c5 0x00 0xcf 0x00>;
			};
		};

		displayport-0-dai-link {
			link-name = "DisplayPort0 Playback";

			platform {
				sound-dai = <0x1c2>;
			};

			cpu {
				sound-dai = <0x1c1 0x68>;
			};

			codec {
				sound-dai = <0x1c0>;
			};
		};

		displayport-2-dai-link {
			link-name = "DisplayPort2 Playback";

			platform {
				sound-dai = <0x1c2>;
			};

			cpu {
				sound-dai = <0x1c1 0x82>;
			};

			codec {
				sound-dai = <0x1c3>;
			};
		};

		wsa-dai-link {
			link-name = "WSA Playback";

			platform {
				sound-dai = <0x1c2>;
			};

			cpu {
				sound-dai = <0x1c1 0x69>;
			};

			codec {
				sound-dai = <0x1c7 0x1c8 0x1c9 0x00 0xd1 0x00>;
			};
		};

		va-dai-link {
			link-name = "VA Capture";

			platform {
				sound-dai = <0x1c2>;
			};

			cpu {
				sound-dai = <0x1c1 0x6e>;
			};

			codec {
				sound-dai = <0xcb 0x00>;
			};
		};

		wcd-capture-dai-link {
			link-name = "WCD Capture";

			platform {
				sound-dai = <0x1c2>;
			};

			cpu {
				sound-dai = <0x1c1 0x78>;
			};

			codec {
				sound-dai = <0x1c4 0x01 0x1c6 0x01 0xd6 0x00>;
			};
		};
	};

	firmware {

		scmi {
			shmem = <0x1b 0x1c>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			compatible = "arm,scmi";
			mboxes = <0x1a 0x00 0x1a 0x02>;
			mbox-names = "tx", "rx";

			scmi_dvfs: protocol@13 {
				#power-domain-cells = <0x01>;
				reg = <0x13>;
				phandle = <0x05>;
			};
		};

		scm: scm {
			interconnects = <0x17 0x02 0x07 0x18 0x01 0x07>;
			compatible = "qcom,scm-x1e80100", "qcom,scm";
			phandle = <0x1d0>;
			qcom,dload-mode = <0x19 0x19000>;
		};
	};

	vreg_wwan: regulator-wwan {
		regulator-max-microvolt = <0x325aa0>;
		pinctrl-names = "default";
		regulator-boot-on;
		gpio = <0x5b 0xdd 0x00>;
		pinctrl-0 = <0x1bf>;
		enable-active-high;
		regulator-min-microvolt = <0x325aa0>;
		regulator-name = "VCC3B_WAN_RCM";
		compatible = "regulator-fixed";
		phandle = <0xb2>;
	};

	chosen {
	};

	dummy-sink {
		compatible = "arm,coresight-dummy-sink";

		in-ports {

			port {

				eud_in: endpoint {
					remote-endpoint = <0x16>;
					phandle = <0x149>;
				};
			};
		};
	};

	qup_opp_table_100mhz: opp-table-qup100mhz {
		compatible = "operating-points-v2";
		phandle = <0x40>;

		opp-100000000 {
			opp-hz = <0x00 0x5f5e100>;
			required-opps = <0x25>;
		};

		opp-75000000 {
			opp-hz = <0x00 0x47868c0>;
			required-opps = <0x24>;
		};
	};

	pmu {
		interrupts = <0x01 0x07 0x08>;
		compatible = "arm,armv8-pmuv3";
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu3: cpu@300 {
			power-domains = <0x08 0x05 0x00>;
			power-domain-names = "psci", "perf";
			device_type = "cpu";
			compatible = "qcom,oryon";
			next-level-cache = <0x03>;
			reg = <0x00 0x300>;
			enable-method = "psci";
			phandle = <0x11>;
			#cooling-cells = <0x02>;
		};

		cpu5: cpu@10100 {
			power-domains = <0x0b 0x05 0x01>;
			power-domain-names = "psci", "perf";
			device_type = "cpu";
			compatible = "qcom,oryon";
			next-level-cache = <0x09>;
			reg = <0x00 0x10100>;
			enable-method = "psci";
			phandle = <0x13>;
			#cooling-cells = <0x02>;
		};

		domain-idle-states {

			cluster_cl4: cluster-sleep-0 {
				entry-latency-us = <0x15e>;
				exit-latency-us = <0x1f4>;
				arm,psci-suspend-param = <0x1000044>;
				compatible = "domain-idle-state";
				phandle = <0x21>;
				min-residency-us = <0x9c4>;
			};

			cluster_cl5: cluster-sleep-1 {
				entry-latency-us = <0x898>;
				exit-latency-us = <0xfa0>;
				arm,psci-suspend-param = <0x1000054>;
				compatible = "domain-idle-state";
				phandle = <0x1cf>;
				min-residency-us = <0x1b58>;
			};
		};

		idle-states {
			entry-method = "psci";

			cluster_c4: cpu-sleep-0 {
				entry-latency-us = <0xb4>;
				idle-state-name = "ret";
				exit-latency-us = <0x140>;
				arm,psci-suspend-param = <0x04>;
				compatible = "arm,idle-state";
				phandle = <0x1f>;
				min-residency-us = <0x258>;
			};
		};

		cpu-map {

			cluster0 {

				core3 {
					cpu = <0x11>;
				};

				core1 {
					cpu = <0x0f>;
				};

				core2 {
					cpu = <0x10>;
				};

				core0 {
					cpu = <0x0e>;
				};
			};

			cluster1 {

				core3 {
					cpu = <0x15>;
				};

				core1 {
					cpu = <0x13>;
				};

				core2 {
					cpu = <0x14>;
				};

				core0 {
					cpu = <0x12>;
				};
			};
		};

		cpu2: cpu@200 {
			power-domains = <0x07 0x05 0x00>;
			power-domain-names = "psci", "perf";
			device_type = "cpu";
			compatible = "qcom,oryon";
			next-level-cache = <0x03>;
			reg = <0x00 0x200>;
			enable-method = "psci";
			phandle = <0x10>;
			#cooling-cells = <0x02>;
		};

		cpu4: cpu@10000 {
			power-domains = <0x0a 0x05 0x01>;
			power-domain-names = "psci", "perf";
			device_type = "cpu";
			compatible = "qcom,oryon";
			next-level-cache = <0x09>;
			reg = <0x00 0x10000>;
			enable-method = "psci";
			phandle = <0x12>;
			#cooling-cells = <0x02>;

			l2_1: l2-cache {
				cache-level = <0x02>;
				cache-unified;
				compatible = "cache";
				phandle = <0x09>;
			};
		};

		cpu0: cpu@0 {
			power-domains = <0x04 0x05 0x00>;
			power-domain-names = "psci", "perf";
			device_type = "cpu";
			compatible = "qcom,oryon";
			next-level-cache = <0x03>;
			reg = <0x00 0x00>;
			enable-method = "psci";
			phandle = <0x0e>;
			#cooling-cells = <0x02>;

			l2_0: l2-cache {
				cache-level = <0x02>;
				cache-unified;
				compatible = "cache";
				phandle = <0x03>;
			};
		};

		cpu7: cpu@10300 {
			power-domains = <0x0d 0x05 0x01>;
			power-domain-names = "psci", "perf";
			device_type = "cpu";
			compatible = "qcom,oryon";
			next-level-cache = <0x09>;
			reg = <0x00 0x10300>;
			enable-method = "psci";
			phandle = <0x15>;
			#cooling-cells = <0x02>;
		};

		cpu1: cpu@100 {
			power-domains = <0x06 0x05 0x00>;
			power-domain-names = "psci", "perf";
			device_type = "cpu";
			compatible = "qcom,oryon";
			next-level-cache = <0x03>;
			reg = <0x00 0x100>;
			enable-method = "psci";
			phandle = <0x0f>;
			#cooling-cells = <0x02>;
		};

		cpu6: cpu@10200 {
			power-domains = <0x0c 0x05 0x01>;
			power-domain-names = "psci", "perf";
			device_type = "cpu";
			compatible = "qcom,oryon";
			next-level-cache = <0x09>;
			reg = <0x00 0x10200>;
			enable-method = "psci";
			phandle = <0x14>;
			#cooling-cells = <0x02>;
		};
	};

